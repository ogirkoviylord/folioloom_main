ENVIRONMENT=development
SERVICE_NAME="FolioLoom Dev"
MAX_UPLOAD_MB=50
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DATABASE_URL=postgresql://translator_dev:translator_dev@localhost:5432/translator_dev
REDIS_URL=redis://localhost:6379/1
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_IDS=
OBJECT_STORAGE_ROOT=var/dev-object-storage
PERSISTENT_JOBS_DB_PATH=var/dev-jobs.sqlite3
USER_SETTINGS_DB_PATH=var/dev-user-settings.sqlite3
TRANSLATION_RUN_LOG_ROOT=var/dev-translation-runs
ADMIN_DB_PATH=var/dev-admin.sqlite3
ADMIN_OWNER_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_SECRET_MASTER_KEY=
ADMIN_COOKIE_SECURE=false
ADMIN_PROVIDER_RUNTIME_RELOAD_SECONDS=30
