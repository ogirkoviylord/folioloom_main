# App
ENVIRONMENT=production
SERVICE_NAME="FolioLoom"
MAX_UPLOAD_MB=50

# Telegram
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_IDS=
# Keep false while collecting candidate IDs; live enforcement is controlled in admin settings.
BETA_ALLOWLIST_ENABLED=false
# Optional bootstrap/default IDs for fresh admin state. Manage the live list in /admin/settings.
BETA_ALLOWLIST_TELEGRAM_IDS=

# Beta safety caps
# Cost caps and kill switch are live admin settings after bootstrapping.
# Token rates are restart/env-only for now.
BETA_TRANSLATIONS_PAUSED=false
BETA_GLOBAL_DAILY_COST_CAP_USD=5.00
BETA_GLOBAL_MONTHLY_COST_CAP_USD=50.00
BETA_USER_DAILY_COST_CAP_USD=1.00
BETA_USER_MONTHLY_COST_CAP_USD=10.00
BETA_USER_DAILY_JOB_LIMIT=3
BETA_MAX_JOB_ESTIMATED_COST_USD=2.00
BETA_COST_INPUT_USD_PER_MILLION=0.28
BETA_COST_OUTPUT_USD_PER_MILLION=1.10
BETA_COST_WARNING_FRACTION=0.80

# DeepSeek
# Env keys remain active even if additional DeepSeek keys are added in admin.
# The admin balance view can use both admin-stored keys and these env keys.
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEYS=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Provider channel safety. Runtime telemetry in admin shows per-key cooldown,
# counters, latency and safe error summaries. Keep per-key parallelism at 1 for
# beta unless the provider account explicitly supports more.
DEEPSEEK_MAX_PARALLEL_PER_KEY=1
DEEPSEEK_CHANNEL_COOLDOWN_SECONDS=30
DEEPSEEK_CHANNEL_MAX_COOLDOWN_SECONDS=300
DEEPSEEK_CHANNEL_COOLDOWN_JITTER_FRACTION=0.20
DEEPSEEK_ADAPTIVE_THROTTLING_ENABLED=true
DEEPSEEK_ADAPTIVE_INITIAL_PARALLEL=1
DEEPSEEK_ADAPTIVE_MIN_PARALLEL=1
DEEPSEEK_ADAPTIVE_SUCCESS_RAMP_INTERVAL=8
DEEPSEEK_ADAPTIVE_DECREASE_FACTOR=0.5
DEEPSEEK_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
DEEPSEEK_PROVIDER_CIRCUIT_RESET_SECONDS=120
DEEPSEEK_CHANNEL_WEIGHTS=

# Persistent backend
SCHEDULER_BACKEND=postgres
POSTGRES_DB=translator
POSTGRES_USER=translator
POSTGRES_PASSWORD=change-me
POSTGRES_DSN=postgresql://translator:change-me@postgres:5432/translator
DATABASE_URL=postgresql://translator:change-me@postgres:5432/translator
REDIS_URL=redis://redis:6379/0

# Storage
OBJECT_STORAGE_ROOT=/data/object-storage
PERSISTENT_JOBS_DB_PATH=/data/runtime/jobs.sqlite3
USER_SETTINGS_DB_PATH=/data/runtime/user-settings.sqlite3
TRANSLATION_RUN_LOG_ROOT=/data/run-logs

# Upload malware/AV scanning
# clamd is an internal Docker service only; do not publish CLAMD_PORT publicly.
REQUIRE_UPLOAD_SCAN=true
UPLOAD_SCANNER_BACKEND=clamd
UPLOAD_SCAN_MAX_CONCURRENCY=1
UPLOAD_SCAN_BACKPRESSURE_TIMEOUT_SECONDS=1.0
CLAMD_IMAGE=clamav/clamav:1.4
CLAMD_PLATFORM=linux/amd64
CLAMD_HOST=clamd
CLAMD_PORT=3310
CLAMD_TIMEOUT_SECONDS=10.0
CLAMD_CHUNK_SIZE_BYTES=65536
CLAMD_RESPONSE_LIMIT_BYTES=4096
CLAMD_STARTUP_TIMEOUT=1800
# Keep above the previously OOM-prone 1g beta limit; tune only after approved
# runtime smoke on the target host.
CLAMD_MEM_LIMIT=2g
CLAMD_CPUS=1.0

# Scheduler
SCHEDULER_LEASE_SECONDS=300
SCHEDULER_POLL_SECONDS=2.0
SCHEDULER_RETRY_BASE_DELAY_SECONDS=30
SCHEDULER_RETRY_MAX_DELAY_SECONDS=600
SCHEDULER_MAX_ACTIVE_UNITS_GLOBAL=16
SCHEDULER_MAX_ACTIVE_UNITS_PER_USER=8
SCHEDULER_MAX_ACTIVE_JOBS_PER_USER=1
SCHEDULER_MAX_ACTIVE_UNITS_PER_JOB=8
SCHEDULER_PRIORITY_AGING_SECONDS=1800

# Translation
# Worker-side scheduled work-unit capacity. Effective provider calls are also
# capped by DeepSeek key capacity: key_count * DEEPSEEK_MAX_PARALLEL_PER_KEY.
TRANSLATION_MAX_PARALLEL_UNITS=8

# Security / repair limits
SECURITY_MAX_EVENTS_PER_RUN=20
SECURITY_MAX_UNSAFE_MODEL_OUTPUTS_PER_RUN=3
SECURITY_MAX_REPAIR_FAILURES_PER_RUN=1
SECURITY_USER_COOLDOWN_THRESHOLDS_PER_WINDOW=2
SECURITY_USER_COOLDOWN_WINDOW_SECONDS=3600
SECURITY_USER_COOLDOWN_SECONDS=900

# Admin
ADMIN_DB_PATH=/data/runtime/admin.sqlite3
ADMIN_SESSION_SECRET=
ADMIN_OWNER_PASSWORD=
# Required for encrypted admin secrets. Without it, admin key storage and
# admin-added DeepSeek keys are unavailable.
ADMIN_SECRET_MASTER_KEY=
ADMIN_COOKIE_SECURE=false
ADMIN_PROVIDER_RUNTIME_RELOAD_SECONDS=30
