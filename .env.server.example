# App
ENVIRONMENT=production
SERVICE_NAME="FolioLoom"
MAX_UPLOAD_MB=50

# Telegram
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_IDS=
# Keep false while collecting candidate IDs; live enforcement is controlled in admin settings.
BETA_ALLOWLIST_ENABLED=false
# Optional bootstrap/default IDs for fresh admin state. Manage the live list in /admin/settings.
BETA_ALLOWLIST_TELEGRAM_IDS=

# DeepSeek
# Env keys remain active even if additional DeepSeek keys are added in admin.
# The admin balance view can use both admin-stored keys and these env keys.
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEYS=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_PARALLEL_PER_KEY=1
DEEPSEEK_CHANNEL_COOLDOWN_SECONDS=30
DEEPSEEK_CHANNEL_MAX_COOLDOWN_SECONDS=300
DEEPSEEK_CHANNEL_WEIGHTS=

# Persistent backend
SCHEDULER_BACKEND=postgres
POSTGRES_DB=translator
POSTGRES_USER=translator
POSTGRES_PASSWORD=change-me
POSTGRES_DSN=postgresql://translator:change-me@postgres:5432/translator
DATABASE_URL=postgresql://translator:change-me@postgres:5432/translator
REDIS_URL=redis://redis:6379/0

# Storage
OBJECT_STORAGE_ROOT=/data/object-storage
PERSISTENT_JOBS_DB_PATH=/data/runtime/jobs.sqlite3
USER_SETTINGS_DB_PATH=/data/runtime/user-settings.sqlite3
TRANSLATION_RUN_LOG_ROOT=/data/run-logs

# Scheduler
SCHEDULER_LEASE_SECONDS=300
SCHEDULER_POLL_SECONDS=2.0
SCHEDULER_RETRY_BASE_DELAY_SECONDS=30
SCHEDULER_RETRY_MAX_DELAY_SECONDS=600
SCHEDULER_MAX_ACTIVE_UNITS_GLOBAL=2
SCHEDULER_MAX_ACTIVE_UNITS_PER_USER=1
SCHEDULER_MAX_ACTIVE_JOBS_PER_USER=1
SCHEDULER_MAX_ACTIVE_UNITS_PER_JOB=1
SCHEDULER_PRIORITY_AGING_SECONDS=1800

# Translation
# Worker-side scheduled work-unit capacity. Effective provider calls are also
# capped by DeepSeek key capacity: key_count * DEEPSEEK_MAX_PARALLEL_PER_KEY.
TRANSLATION_MAX_PARALLEL_UNITS=2

# Security / repair limits
SECURITY_MAX_EVENTS_PER_RUN=20
SECURITY_MAX_UNSAFE_MODEL_OUTPUTS_PER_RUN=3
SECURITY_MAX_REPAIR_FAILURES_PER_RUN=1
SECURITY_USER_COOLDOWN_THRESHOLDS_PER_WINDOW=2
SECURITY_USER_COOLDOWN_WINDOW_SECONDS=3600
SECURITY_USER_COOLDOWN_SECONDS=900

# Admin
ADMIN_DB_PATH=/data/runtime/admin.sqlite3
ADMIN_SESSION_SECRET=
ADMIN_OWNER_PASSWORD=
# Required for encrypted admin secrets. Without it, admin key storage and
# admin-added DeepSeek keys are unavailable.
ADMIN_SECRET_MASTER_KEY=
ADMIN_COOKIE_SECURE=false
ADMIN_PROVIDER_RUNTIME_RELOAD_SECONDS=30
